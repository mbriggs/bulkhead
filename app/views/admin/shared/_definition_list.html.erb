<%# Key-value definition list. Receives +items+ and +columns+ from AdminDefinitionListBuilder. %>
<% grid_class = "cols-#{[2, 3, 4].include?(columns) ? columns : 2}" %>
<dl class="<%= classnames('admin-definition-list', grid_class) %>">
  <% items.each do |item| %>
    <% span_class = [2, 3, 4].include?(item.span) ? "span-#{item.span}" : nil %>
    <div class="<%= classnames('admin-definition-list-item', span_class) %>">
      <dt class="admin-definition-list-term"><%= item.label %></dt>
      <dd class="admin-definition-list-details">
        <% if item.value.respond_to?(:call) %>
          <%= capture(&item.value) %>
        <% else %>
          <%= item.value %>
        <% end %>
      </dd>
    </div>
  <% end %>
</dl>
