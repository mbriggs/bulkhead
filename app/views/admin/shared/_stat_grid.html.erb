<%# Responsive grid of borderless dot-style stat counters. Receives +stats+ from AdminStatGridBuilder. %>
<div class="admin-stat-grid">
  <% stats.each do |stat| %>
    <%
      dot_colors = {
        zinc:   nil,
        blue:   "admin-stat-dot info",
        green:  "admin-stat-dot success",
        red:    "admin-stat-dot danger",
        yellow: "admin-stat-dot warning",
        purple: "admin-stat-dot purple",
      }
      dot_class = dot_colors.fetch(stat.color, dot_colors[:zinc])
    %>
    <% wrapper_tag = stat.href ? :a : :div %>
    <%= content_tag(wrapper_tag, class: "admin-stat", href: stat.href) do %>
      <div class="admin-stat-row">
        <span class="<%= classnames('admin-stat-dot', dot_class) %>">&bull;</span>
        <div class="admin-stat-value"><%= stat.value %></div>
      </div>
      <div class="admin-stat-label">
        <% if stat.hint %>
          <%= tooltip(stat.hint, position: :bottom) do %>
            <span class="admin-stat-hint"><%= stat.label %></span>
          <% end %>
        <% else %>
          <%= stat.label %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
<%= page_separator(size: :sm) %>
