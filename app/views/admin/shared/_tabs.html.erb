<%# Pill-style tabs with optional counts. Receives +tabs+ from AdminTabsBuilder. %>
<div class="admin-tabs">
  <% tabs.each do |tab| %>
    <a href="<%= tab.href %>"
       class="<%= classnames('admin-tabs-tab', { 'active' => tab.active }) %>">
      <%= tab.label %>
      <% if tab.count %>
        <span class="admin-tabs-count"><%= tab.count %></span>
      <% end %>
    </a>
  <% end %>
</div>
