<%= page_header "Cards" do |h| %>
  <%= h.breadcrumb "Kitchen Sink", kitchen_sink_path %>
<% end %>

<%= page do %>
  <div class="<%= card_classes %>">
    <%= card_header("Basic Card", "The simplest card. Use card_classes for consistent border, shadow, and background.") %>

    <div class="demo-card-body">
      <div class="<%= card_classes %>">
        <div class="demo-card-body">
          <h3 class="demo-title">
            Simple Card
          </h3>

          <p class="demo-offset-sm demo-muted">
            This is a basic card using <code>card_classes</code> for consistent
            styling.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Card with Header", "Add card_header inside a card for a titled section with a bottom border.") %>

    <div class="demo-card-body">
      <div class="<%= card_classes %>">
        <%= card_header("Card Title", "Optional subtitle describing the card content") %>

        <div class="demo-card-body">
          <p class="demo-text">
            Card body content goes here.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Detail Card", "Use detail_card for key-value layouts like profiles or settings.") %>

    <div class="demo-card-body">
      <%= detail_card("User Profile", subtitle: "Account information") do |c|
        c.section("Name") { "Jane Smith" }
        c.section("Email") { "jane@example.com" }
        c.section("Role") { status_badge(true, labels: { true => "Admin", false => "Member" }) }
        c.section("Bio") { "Product manager focused on developer tools and workflow automation." }
      end %>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Detail Card with Header Action", "Pass header_action: to place a button in the card header. Use for inline edit actions.") %>

    <div class="demo-card-body">
      <%= detail_card("Project Settings", header_action: button("Edit", type: :secondary, size: :sm, shadow: false, icon_name: :pencil)) do |c|
        c.section("Project Name") { "Factory" }
        c.section("Status") { status_badge(true) }
        c.section("Created") { "February 10, 2026" }
      end %>
    </div>
  </div>

  <div class="<%= card_classes %> wide">
    <%= card_header("Card Grid", "Cards in a responsive grid. Use demo-grid or page columns for progressive layouts.") %>

    <div class="demo-card-body">
      <div class="demo-grid three">
        <% 3.times do |i| %>
          <div class="<%= card_classes %>">
            <div class="demo-card-body">
              <div class="demo-row with-gap">
                <%= icon(:folder, classes: "demo-icon sm primary") %>

                <h4 class="demo-label">
                  Project <%= i + 1 %>
                </h4>
              </div>

              <p class="demo-muted">
                A sample project card showing how cards look in a grid layout.
              </p>

              <div class="demo-offset"><%= status_badge(i.even?) %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Flat Card", "Use card_classes(shadow: false) for cards nested inside other cards. Same border and background, no shadow.") %>

    <div class="demo-card-body">
      <div class="<%= card_classes(shadow: false) %>">
        <div class="demo-card-body">
          <h3 class="demo-title">
            Nested Card (Flat)
          </h3>

          <p class="demo-offset-sm demo-muted">
            This card lives inside a parent card. It uses <code>card_classes(shadow: false)</code>
            to avoid stacking shadows.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Panel", "Use panel_classes for border-only containment inside cards. Ideal for tables and forms.") %>

    <div class="demo-card-body">
      <div class="<%= panel_classes %>">
        <table class="demo-table">
          <thead>
            <tr>
              <th class="demo-table-heading">Name</th>
              <th class="demo-table-heading">Status</th>
            </tr>
          </thead>
          <tbody class="demo-table-body">
            <tr>
              <td class="demo-table-cell">Import pipeline</td>
              <td class="demo-table-cell"><%= status_badge(true) %></td>
            </tr>
            <tr>
              <td class="demo-table-cell">Research pipeline</td>
              <td class="demo-table-cell"><%= status_badge(false) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Inset", "Use inset_classes for metadata blocks inside cards. Grey background with a left accent stripe.") %>

    <div class="demo-card-body">
      <div class="<%= inset_classes("demo-card-body") %>">
        <dl class="demo-grid two compact">
          <div>
            <dt class="demo-label">Status</dt>
            <dd class="demo-definition-details muted">Ready for review</dd>
          </div>
          <div>
            <dt class="demo-label">Last updated</dt>
            <dd class="demo-definition-details muted">2 hours ago</dd>
          </div>
          <div>
            <dt class="demo-label">Author</dt>
            <dd class="demo-definition-details muted">Alice Johnson</dd>
          </div>
          <div>
            <dt class="demo-label">Risk tier</dt>
            <dd class="demo-definition-details muted">Medium</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Flat Detail Card", "Use detail_card(..., shadow: false) for detail cards nested inside other cards.") %>

    <div class="demo-card-body">
      <%= detail_card("Nested Profile", subtitle: "Inside a parent card", shadow: false) do |c|
        c.section("Name") { "Jane Smith" }
        c.section("Email") { "jane@example.com" }
        c.section("Role") { status_badge(true, labels: { true => "Admin", false => "Member" }) }
      end %>
    </div>
  </div>

  <div class="<%= card_classes %> wide">
    <%= card_header("Nested Containers", "A card containing both a panel and an inset, demonstrating flat inner containers.") %>

    <div class="demo-card-body demo-stack md">
      <div class="demo-grid two compact">
        <div>
          <h4 class="demo-label with-gap">Panel (table)</h4>
          <div class="<%= panel_classes %>">
            <table class="demo-table">
              <thead>
                <tr>
                  <th class="demo-table-heading">Item</th>
                  <th class="demo-table-heading align-right">Count</th>
                </tr>
              </thead>
              <tbody class="demo-table-body">
                <tr>
                  <td class="demo-table-cell">Tasks</td>
                  <td class="demo-table-cell align-right muted">12</td>
                </tr>
                <tr>
                  <td class="demo-table-cell">Tickets</td>
                  <td class="demo-table-cell align-right muted">8</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h4 class="demo-label with-gap">Inset (metadata)</h4>
          <div class="<%= inset_classes("padded") %>">
            <dl class="demo-stack compact">
              <div>
                <dt class="demo-label">Created</dt>
                <dd class="demo-muted">February 10, 2026</dd>
              </div>
              <div>
                <dt class="demo-label">Updated</dt>
                <dd class="demo-muted">February 24, 2026</dd>
              </div>
              <div>
                <dt class="demo-label">Owner</dt>
                <dd class="demo-muted">Alice Johnson</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
