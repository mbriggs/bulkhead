<%= page_header "Empty States" do |h| %>
  <%= h.breadcrumb "Kitchen Sink", kitchen_sink_path %>
<% end %>

<%= page do %>
  <div class="<%= card_classes %>">
    <%= card_header("Minimal", "Just a message, no icon or title. Use for inline empty states in small containers.") %>
    <%= empty_state("No items found") %>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("With Title", "Add icon: and title: for a prominent empty state when the collection is the main content.") %>
    <%= empty_state("Get started by creating your first project.", icon: :folder_plus, title: "No projects yet") %>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("With Action", "Add action_text: and action_path: to give the user a clear next step.") %>
    <%= empty_state(
      "Problems will appear here once you create one.",
      icon: :document_text,
      title: "No Problems",
      action_text: "Create Problem",
      action_path: empty_states_kitchen_sink_path
    ) %>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Different Icons", "Pick an icon that matches the missing content type.") %>
    <div class="demo-card-body">
      <div class="demo-grid three">
        <div class="<%= card_classes %>">
          <%= empty_state("No notifications yet.", icon: :bell, title: "No Notifications") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("No team members found.", icon: :user_group, title: "No Members") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("Nothing in your inbox.", icon: :inbox, title: "All Caught Up") %>
        </div>
      </div>
    </div>
  </div>

  <div class="<%= card_classes %>">
    <%= card_header("Illustrations", "Pass illustration: to use a custom line illustration in place of the heroicon. Two-color (zinc base + primary accent) with dark-mode variants.") %>
    <div class="demo-card-body">
      <div class="demo-grid three">
        <div class="<%= card_classes %>">
          <%= empty_state("Try a different query.", illustration: :no_results, title: "No matches") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("New mail will appear here.", illustration: :empty_inbox, title: "Inbox empty") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("Charts populate after the first run.", illustration: :no_data, title: "No data yet") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("Something went wrong loading this view.", illustration: :error, title: "Error") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("Everything's processed and on its way.", illustration: :success, title: "All done") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("Ask an admin to grant access.", illustration: :permission, title: "Restricted") %>
        </div>
        <div class="<%= card_classes %>">
          <%= empty_state("Crunching the numbers — this can take a moment.", illustration: :loading, title: "Loading") %>
        </div>
      </div>
    </div>
  </div>
<% end %>
