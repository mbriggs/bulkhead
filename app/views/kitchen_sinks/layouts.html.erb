<%= page_header "Layouts" do |h| %>
  <%= h.breadcrumb "Kitchen Sink", kitchen_sink_path %>
<% end %>

<%= page(columns: false) do %>
  <%# ── Section ── %>
  <div class="<%= card_classes %>">
    <%= card_header("Section", "Standalone section helper for grouping content outside forms. Supports title, description text, separator, and grid layout.") %>
    <div class="demo-card-body">
      <%= section "Plain Section" do %>
        <p class="demo-text">
          Default section with just a title. No separator, no grid.
        </p>
      <% end %>

      <%= section "With Description", text: "Optional description text appears below the title in smaller type." do %>
        <p class="demo-text">
          Section body content goes here.
        </p>
      <% end %>

      <%= section "With Separator", separator: true do %>
        <p class="demo-text">
          Pass <code>separator: true</code> to add a top border dividing this section from the one above.
        </p>
      <% end %>

      <%= section "Grid Layout", grid: true do %>
        <div class="span-6">
          <div class="demo-box">Column 1</div>
        </div>
        <div class="span-6">
          <div class="demo-box">Column 2</div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Section Head ── %>
  <div class="<%= card_classes %>">
    <%= card_header("Section Head", "Compact section header — uppercase title with optional meta line. Sits above a sibling content card on operational surfaces (dashboards, list pages) where the head shouldn't wrap the body.") %>
    <div class="demo-card-body demo-stack lg">
      <div>
        <p class="demo-label">Title only</p>
        <%= section_head("In flight") %>
        <div class="<%= card_classes(shadow: false) %> demo-offset">
          <p class="demo-text">Sibling content card sits below the head.</p>
        </div>
      </div>

      <div>
        <p class="demo-label">Title + meta</p>
        <%= section_head("Last 24 hours", meta: "5 finished · 100% success") %>
        <div class="<%= card_classes(shadow: false) %> demo-offset">
          <p class="demo-text">Meta sits flush right, baseline-aligned with the title.</p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Page Sidebar ── %>
  <div class="<%= card_classes %>">
    <%= card_header("Page Sidebar", "12-column grid with an 8/4 content-sidebar split. Use page(columns: 12) with page_sidebar().") %>
    <div class="demo-card-body">
      <p class="demo-muted with-gap">
        The layout below simulates the 8/4 split. In production, use
        <code>page(columns: 12)</code> as the outer wrapper with
        <code>page_sidebar(sticky: true)</code> for the right column.
      </p>
      <div class="demo-layout-grid">
        <div class="span-8">
          <div class="demo-box dashed">
            Main content area — <code>span-8</code>
          </div>
        </div>
        <div class="span-4 demo-stack lg">
          <div class="demo-box dashed">
            Sidebar — <code>page_sidebar()</code>
          </div>
          <p class="demo-note">
            Options: <code>sticky: true</code> (sticks on scroll), <code>size: :small</code> (3 columns instead of 4).
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Page Column Variants ── %>
  <div class="<%= card_classes %>">
    <%= card_header("Page Column Variants", "The page() helper accepts columns: to control the grid. Use an integer, a class token, or false.") %>
    <div class="demo-card-body demo-stack lg">
      <div>
        <p class="demo-label"><code>columns: 2</code> (default)</p>
        <div class="demo-grid two compact">
          <div class="demo-box">Card 1</div>
          <div class="demo-box">Card 2</div>
        </div>
      </div>

      <div>
        <p class="demo-label"><code>columns: 3</code></p>
        <div class="demo-grid three compact">
          <div class="demo-box">Card 1</div>
          <div class="demo-box">Card 2</div>
          <div class="demo-box">Card 3</div>
        </div>
      </div>

      <div>
        <p class="demo-label"><code>columns: false</code> (single column)</p>
        <div class="demo-grid compact">
          <div class="demo-box">Full-width card</div>
        </div>
      </div>
    </div>
  </div>

  <%# ── Section Gap ── %>
  <div class="<%= card_classes %>">
    <%= card_header("Section Gap", "Vertical spacing utilities for detail pages. Apply .section-gap-top on the block that follows a sibling section, or .section-gap-bottom on the block that precedes one.") %>
    <div class="demo-card-body demo-stack lg">
      <div>
        <p class="demo-label">Without gap (baseline)</p>
        <div class="demo-box dashed">First section</div>
        <div class="demo-box dashed">Second section (sits flush)</div>
      </div>

      <div>
        <p class="demo-label"><code>.section-gap-top</code> on the second block</p>
        <div class="demo-box dashed">First section</div>
        <div class="demo-box dashed section-gap-top">Second section (pushed down)</div>
      </div>

      <div>
        <p class="demo-label"><code>.section-gap-bottom</code> on the first block</p>
        <div class="demo-box dashed section-gap-bottom">First section (pushed up)</div>
        <div class="demo-box dashed">Second section</div>
      </div>
    </div>
  </div>
<% end %>
