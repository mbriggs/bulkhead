<%= page_header "Kitchen Sink" %>

<%= page(columns: false) do %>
  <div class="<%= card_classes %>">
    <%= card_header("Welcome", "Browse Bulkhead's helpers, controllers, and CSS components from the sidebar.") %>
    <div class="demo-card-body demo-stack lg">
      <p class="demo-text">
        This is the dev-only component showcase. Each section in the sidebar
        renders a category of helpers in isolation, with copy-pasteable usage
        examples and edge cases (errored forms, empty states, dark mode).
      </p>

      <%= section "Getting around" do %>
        <ul class="demo-stack sm">
          <li class="demo-text">
            <strong>Foundations</strong> — design tokens, typography, layout primitives, the icon set.
          </li>
          <li class="demo-text">
            <strong>Surfaces</strong> — cards, page headers, modals, reader mode.
          </li>
          <li class="demo-text">
            <strong>Controls</strong> — buttons, forms, tabs, Stimulus controllers (toggles, comboboxes, bulk select, etc.).
          </li>
          <li class="demo-text">
            <strong>Data</strong> — tables, item lists, pagination, empty states.
          </li>
          <li class="demo-text">
            <strong>Feedback</strong> — alerts and badges.
          </li>
        </ul>
      <% end %>

      <%= section "Conventions", separator: true do %>
        <p class="demo-text">
          Bulkhead exposes complete HTML through helpers (<code>card</code>,
          <code>page_header</code>, <code>button</code>, <code>section</code>, …)
          rather than partials or view components. Stimulus controllers are
          auto-attached via data attributes the helpers emit.
        </p>
      <% end %>
    </div>
  </div>
<% end %>
