<% if model.errors.any? %>
  <div class="alert danger summary" id="error_summary">
    <div class="alert-layout">
      <div class="alert-icon-wrap">
        <%= icon_by_name(:exclamation_triangle, classes: "alert-icon") %>
      </div>
      <div class="alert-body">
        <h3 class="alert-title">
          <% model_name = model.class.name.demodulize.underscore.humanize.downcase %>
          <%= pluralize(model.errors.count, 'error') %> prohibited this <%= model_name %> from being saved
        </h3>
        <div class="alert-content">
          <ul role="list" class="alert-list">
            <% model.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>
