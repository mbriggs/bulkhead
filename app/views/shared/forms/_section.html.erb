<div class="<%= container_classes %>">
  <% if title.present? %>
    <% if header_action_content.present? %>
      <div class="section-header">
        <h2 class="section-title"><%= title %></h2>
        <%= header_action_content %>
      </div>
    <% else %>
      <h2 class="section-title"><%= title %></h2>
    <% end %>
  <% end %>

  <% if text.present? %>
    <p class="section-text"><%= text %></p>
  <% end %>

  <div class="<%= section_classes %>">
    <%= body_content %>
  </div>
</div>
