<div class="<%= card_classes(shadow: shadow) %>">
  <% if title %>
    <% if header_action %>
      <div class="card-header detail-card-header">
        <div>
          <h3 class="card-title"><%= title %></h3>
          <% if subtitle %>
            <p class="card-subtitle"><%= subtitle %></p>
          <% end %>
        </div>
        <%= header_action %>
      </div>
    <% else %>
      <%= card_header(title, subtitle) %>
    <% end %>
  <% end %>
  <dl class="detail-list">

    <% sections.each_with_index do |(label, content_block), index| %>
      <% if index > 0 %>
        <div class="detail-list-separator">
          <%= page_separator(size: :sm) %>
        </div>
      <% end %>

      <div>
        <% if label.present? %>
          <dt class="detail-list-term"><%= label %>:</dt>
          <dd class="detail-list-details">
            <%= capture(&content_block) if content_block %>
          </dd>
        <% else %>
          <dd class="detail-list-details empty-label">
            <%= capture(&content_block) if content_block %>
          </dd>
        <% end %>
      </div>
    <% end %>
  </dl>
</div>
