<% show_separator = local_assigns.fetch(:separator, true) %>
<% if local_assigns[:sticky] && sticky %>
  <div class="page-header" data-controller="sticky-header">
    <div class="page-header-sticky" data-sticky-header-target="header">
      <div class="page-header-inner" data-sticky-header-target="inner">
        <%= render "shared/page/header_content",
          title: title,
          breadcrumbs: breadcrumbs,
          data: data,
          actions: actions,
          primary_actions: primary_actions,
          dropdown_actions: dropdown_actions,
          custom_entries: custom_entries %>
      </div>
    </div>

    <% if show_separator %><%= page_separator %><% end %>

    <div>
      <div id="flash_messages">
        <%= render partial: "shared/system/flash_messages" %>
      </div>
    </div>
  </div>
<% else %>
  <div class="page-header">
    <%= render "shared/page/header_content",
      title: title,
      breadcrumbs: breadcrumbs,
      data: data,
      actions: actions,
      primary_actions: primary_actions,
      dropdown_actions: dropdown_actions,
      custom_entries: custom_entries %>

    <% if show_separator %><%= page_separator %><% end %>

    <div id="flash_messages">
      <%= render partial: "shared/system/flash_messages" %>
    </div>
  </div>
<% end %>
