<div class="page-header-actions">
  <%# Custom Entries %>
  <% (local_assigns[:custom_entries] || []).each do |html| %>
    <div class="page-header-desktop-only"><%= html %></div>
  <% end %>

  <%# Regular Actions %>
  <% actions.each_with_index do |(name, url, opts), index| %>
    <% if opts[:modal] %>
      <% # Co-located modal with trigger %>
      <% modal_id = "page-header-modal-#{index}" %>
      <div data-controller="modal" class="page-header-desktop-only">
        <%= button(name,
          type: opts[:type] || :secondary,
          size: :lg,
          data: {
            action: "modal#open"
          },
          **opts.except(:type, :modal, :locals)) %>
        <%= render partial: opts[:modal], locals: { modal_id: modal_id, modal_title: name }.merge(opts.fetch(:locals, {})) %>
      </div>
    <% else %>
      <span class="page-header-desktop-only">
        <%= button(name, type: opts[:type] || :secondary, size: :lg, url:, **opts.except(:type)) %>
      </span>
    <% end %>
  <% end %>

  <%# Primary Actions %>
  <% primary_actions.each_with_index do |(name, url, opts), index| %>
    <% if opts[:modal] %>
      <% # Co-located modal with trigger %>
      <% modal_id = "page-header-modal-primary-#{index}" %>
      <div data-controller="modal">
        <%= button(name,
          size: :lg,
          classes: "page-header-button",
          data: {
            action: "modal#open"
          },
          **opts.except(:modal, :locals)) %>
        <%= render partial: opts[:modal], locals: { modal_id: modal_id, modal_title: name }.merge(opts.fetch(:locals, {})) %>
      </div>
    <% else %>
      <%= button(name, size: :lg, url:, classes: "page-header-button", **opts) %>
    <% end %>
  <% end %>

  <%# Dropdown Actions %>
  <% (dropdown_actions || []).each do |name, items, opts| %>
    <div class="page-header-dropdown" data-controller="menu">
      <%= button name,
                icon_name: :chevron_down,
                icon_right: true,
                type: opts[:type] || :secondary,
                size: :lg,
                classes: "page-header-dropdown-button",
                data: { action: 'click->menu#toggle' },
                **opts.except(:type) %>
      <div class="page-menu hidden"
           data-controller="visibility-toggle"
           data-menu-target="toggleable"
           data-visibility-toggle-hiding-complete-class="hidden"
           data-visibility-toggle-state-value="hidden"
           role="menu">
        <% if items && items.any? %>
          <% items.each_with_index do |item, item_index| %>
            <% if item[:divider] %>
              <div class="page-menu-divider"></div>
            <% elsif item[:modal] %>
              <% modal_id = "dropdown-modal-#{item_index}" %>
              <div data-controller="modal">
                <button type="button"
                        class="page-menu-item"
                        data-action="click->modal#open">
                  <%= item[:name] %>
                </button>
                <%= render partial: item[:modal], locals: { modal_id: modal_id, modal_title: item[:name] }.merge(item.fetch(:locals, {})) %>
              </div>
            <% else %>
              <%= link_to item[:name],
                          item[:url],
                          class: "page-menu-item",
                          **item.fetch(:options, {}) %>
            <% end %>
          <% end %>
        <% else %>
          <div class="page-menu-empty">No actions available</div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Mobile Menu %>
  <% if actions.any? %>
    <div class="page-header-mobile-menu" data-controller="menu">
      <%= button "More", type: :secondary, size: :lg, icon_name: :chevron_down, icon_right: true, classes: "page-header-button", id: "mobile-menu-button", data: { action: "click->menu#toggle" } %>

      <div
        class="page-menu mobile hidden"
        role="menu"
        data-controller="visibility-toggle"
        data-menu-target="toggleable"
        data-visibility-toggle-hiding-complete-class="hidden"
        data-visibility-toggle-state-value="hidden"
        aria-orientation="vertical"
        aria-labelledby="mobile-menu-button"
        tabindex="-1">

        <% actions.each do |name, url, opts| %>
          <%= link_to name, url, class: "page-menu-item", **opts.except(:modal, :locals, :type) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
