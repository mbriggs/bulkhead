<%= tag.div(class: classnames("alert", tone), data: (disclosure ? { controller: "disclosure" } : {})) do %>
  <div class="alert-layout">
    <div class="alert-icon-wrap">
      <%= icon %>
    </div>
    <div class="alert-body">
      <div class="alert-header">
        <h3 class="alert-title"><%= title %></h3>
        <% if disclosure && content %>
          <button class="alert-toggle"
            data-action="disclosure#toggle"
            data-disclosure-show-text="Show detail"
            data-disclosure-hide-text="Hide detail">Show detail</button>
        <% end %>
      </div>
      <% if content %>
        <%= tag.div(content,
              class: classnames("alert-content", { "hidden" => disclosure }),
              data: (disclosure ? { disclosure_target: "content" } : {})) %>
      <% end %>
    </div>
  </div>
<% end %>
