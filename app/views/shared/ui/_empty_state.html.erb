<%#
  Empty state placeholder for lists and collections.

  Usage:
    render "shared/ui/empty_state",
           illustration: :no_results,
           title: "Nothing found",
           message: "Try a different search."

    Or with a heroicon (legacy / fallback):
    render "shared/ui/empty_state",
           icon: :inbox,
           title: "No items yet",
           message: "Get started by adding your first item."

    With action:
    render "shared/ui/empty_state",
           illustration: :empty_inbox,
           title: "Your cart is empty",
           message: "Browse products to add items.",
           action_text: "Browse Products",
           action_path: products_path

  Locals:
    illustration: Symbol - Named line illustration (preferred); see
      EMPTY_STATE_ILLUSTRATIONS in UiHelper for the allowed set.
    icon: Symbol - Heroicon name (fallback when illustration: not given).
    title: String - Main heading (optional)
    message: String - Description text (required)
    action_text: String - Button text (optional)
    action_path: String - Button URL (optional)
    classes: String - Additional wrapper classes (optional)
%>
<%
  illustration ||= nil
  icon ||= :inbox
  title ||= nil
  action_text ||= nil
  action_path ||= nil
  classes ||= "default-spacing"
%>

<div class="empty-state <%= classes %>">
  <% if illustration %>
    <%= render "shared/ui/empty_state_illustration", name: illustration %>
  <% else %>
    <%= icon(icon, classes: "empty-state-icon") %>
  <% end %>
  <% if title %>
    <h3 class="empty-state-title"><%= title %></h3>
  <% end %>
  <p class="<%= classnames('empty-state-message', { 'no-title' => !title }) %>"><%= message %></p>
  <% if action_text && action_path %>
    <div class="empty-state-action">
      <%= link_to action_text, action_path,
          class: "button primary md shadow" %>
    </div>
  <% end %>
</div>
