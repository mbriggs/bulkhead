<div class="<%= classes %>">
  <% items.each_with_index do |item, idx| %>
    <% border = idx < items.size - 1 ? "item-list-border" : "" %>
    <% row_classes = "item-list-row" %>

    <%# Shared item body: image + title/metas + badges + chevron %>
    <% item_body = capture do %>
      <% if item[:image] %>
        <div class="item-list-media">
          <% if item[:image][:url] %>
            <%= image_tag item[:image][:url],
                class: "item-list-image",
                alt: item[:image][:alt] %>
          <% else %>
            <div class="item-list-media fallback">
              <% icon_name = item[:image][:fallback_icon] || :photograph %>
              <%= icon_by_name(icon_name, classes: "item-list-fallback-icon") %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="item-list-body">
        <% if item[:title] %>
          <p class="item-list-title <%= item[:title][:classes] %>">
            <%= item[:title][:text] %>
          </p>
        <% end %>

        <% if item[:metas].present? %>
          <div class="item-list-meta">
            <% item[:metas].each do |meta| %>
              <span class="item-list-meta-item <%= meta[:classes] %>">
                <% if meta[:icon] %>
                  <%= icon_by_name(meta[:icon], classes: "item-list-meta-icon") %>
                <% end %>
                <%= meta[:text] %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if item[:badges].present? %>
        <div class="item-list-badges">
          <% item[:badges].each do |badge| %>
            <span class="badge <%= badge_color_classes(badge[:type]) %>">
              <% if badge[:icon] %>
                <%= icon_by_name(badge[:icon], classes: "item-list-badge-icon") %>
              <% end %>
              <%= badge[:text] %>
            </span>
          <% end %>
        </div>
      <% end %>

      <div class="item-list-chevron">
        <%= icon(:chevron_right, classes: "item-list-chevron-icon") %>
      </div>
    <% end %>

    <% if item[:modal] %>
      <%= modal_wrapper(tag_name: :div, classes: border) do %>
        <%= modal_open_button(options: { class: row_classes }) do %>
          <%= item_body %>
        <% end %>

        <% m = item[:modal] %>
        <% if m[:partial] %>
          <%= modal_dialog(id: m[:id], title: m[:title], size: m[:size] || :md, header_actions: m[:header_actions], partial: m[:partial], locals: m[:locals] || {}) %>
        <% elsif m[:block] %>
          <%= modal_dialog(id: m[:id], title: m[:title], size: m[:size] || :md, header_actions: m[:header_actions]) do %>
            <%= capture(&m[:block]) %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= link_to item[:path], class: "#{row_classes} #{border}" do %>
        <%= item_body %>
      <% end %>
    <% end %>
  <% end %>
</div>
