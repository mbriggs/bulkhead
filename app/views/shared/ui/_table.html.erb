<div class="<%= classes %>">
  <div class="table-frame">
    <table class="table">
      <thead>
        <tr>
          <% headers.each do |h| %>
            <th scope="col" class="<%= h[:classes] %>">
              <%= h[:title] %>
            </th>
          <% end %>
        </tr>
      </thead>
      <%= tag.tbody(**tbody_attrs) do %>
        <%= body %>
        <% if pager %>
          <%= table_paginate pager, columns: headers.length %>
        <% end %>
      <% end %>
    </table>
  </div>
</div>
