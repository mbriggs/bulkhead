<div class="<%= classes %>">
  <table class="table data">
    <% if headers.any? { |h| h[:title].present? } %>
      <thead>
        <tr>
          <% headers.each do |h| %>
            <th scope="col" class="<%= h[:classes] %>">
              <%= h[:title] %>
            </th>
          <% end %>
        </tr>
      </thead>
    <% end %>
    <%= tag.tbody(**tbody_attrs) do %>
      <%= body %>
      <% if pager %>
        <%= table_paginate pager, columns: headers.length %>
      <% end %>
    <% end %>
  </table>
</div>
