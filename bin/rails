#!/usr/bin/env ruby
# Boots the dummy Rails app at test/dummy/ so you can run the kitchen sink
# in isolation. Usage: bin/rails server
#
# For `bin/rails test`, delegate to the engine's rake test task. The dummy
# app sets Rails.root = test/dummy/, which puts test_helper.rb out of
# $LOAD_PATH for engine tests at test/**/*_test.rb. rake test loads from
# the engine root where test_helper actually lives.
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

if ARGV.first == "test"
  Dir.chdir(File.expand_path("..", __dir__))
  exec("bundle", "exec", "rake", "test", *ARGV[1..])
end

APP_PATH = File.expand_path("../test/dummy/config/application", __dir__)
require_relative "../test/dummy/config/boot"
require "rails/commands"
