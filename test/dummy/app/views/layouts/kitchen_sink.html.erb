<!DOCTYPE html>
<html>
  <head>
    <title>Bulkhead Kitchen Sink</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      // FOUC guard: apply theme synchronously before paint.
      (function () {
        var saved = localStorage.getItem("theme");
        var prefers = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var dark = saved === "dark" || (saved !== "light" && prefers);
        if (dark) document.documentElement.classList.add("is-dark");
      })();
    </script>

    <%= stylesheet_link_tag "bulkhead", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="shell">
    <div class="shell">
      <% sidebar_actions = render("layouts/theme_toggle", classes: "shell-sidebar-theme-toggle") %>
      <% sidebar_footer = capture do %>
        <button type="button" class="shell-sidebar-project" aria-label="Switch workspace">
          <span class="shell-sidebar-project-dot" aria-hidden="true"></span>
          <span class="shell-sidebar-project-name">Demo workspace</span>
          <span class="shell-sidebar-project-kbd"><kbd>⌘</kbd><kbd>K</kbd></span>
        </button>
        <div class="shell-sidebar-user">
          <button type="button" class="shell-sidebar-avatar" aria-label="Account menu">BK</button>
        </div>
      <% end %>
      <%= shell_sidebar brand: "Bulkhead", brand_href: kitchen_sink_path, brand_icon: :sparkles,
                        actions: sidebar_actions,
                        footer: sidebar_footer do %>
        <% kitchen_sink_sections.each do |group_label, items| %>
          <%= shell_nav_section(group_label) if group_label %>
          <% items.each do |s| %>
            <%= menu_item s[:icon], s[:name], s[:path], exact: s[:path] == kitchen_sink_path %>
          <% end %>
        <% end %>
      <% end %>

      <div class="shell-scrim" data-shell-target="scrim" data-action="click->shell#close"></div>

      <main class="shell-content">
        <header class="shell-mobile-header">
          <button type="button" class="shell-icon-button" data-action="shell#toggle" aria-label="Open menu">
            <%= icon(:bars_3, classes: "shell-icon") %>
          </button>
          <%= render "layouts/theme_toggle" %>
        </header>

        <div class="shell-content-inner">
          <% if flash[:notice] %>
            <div class="flash-notice" role="alert"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="flash-alert" role="alert"><%= flash[:alert] %></div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
